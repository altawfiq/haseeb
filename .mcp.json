{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--browser", "chromium",
        "--executable-path", "/opt/pw-browsers/chromium",
        "--proxy-server", "${HTTPS_PROXY}",
        "--proxy-bypass", "localhost,127.0.0.1",
        "--viewport-size", "1440x900",
        "--output-dir", ".playwright-mcp"
      ]
    }
  }
}
